rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products are public catalog data.
    // NOTE: allowing writes to everyone is fine for development but NOT safe
    // for production. Lock this down (e.g. auth-based rules) before shipping.
    match /products/{productId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
